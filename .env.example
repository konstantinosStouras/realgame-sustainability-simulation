HOST=127.0.0.1
PORT=3000
DATA_PATH=.data/simulation.sqlite
FIREBASE_PROJECT_ID=stouras-sustainability-2026
# Allowed frontend origin if served separately from the backend (one origin).
ALLOWED_ORIGIN=https://www.stouras.com
# Additional instructor UIDs may be configured here; no emails or secrets in public code.
FIREBASE_INSTRUCTOR_UIDS=
# Set true with application-default credentials to check disabled/revoked Firebase accounts on every request.
FIREBASE_CHECK_REVOKED=false
