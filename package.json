{
  "name": "sustainability-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent multiplayer sustainability teaching simulation",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "demo": "node server/main.mjs --demo",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.mjs && node --check src/engine.mjs && node --check server/main.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1"
  }
}
